# Copy to .env (never commit .env). Validated at startup by src/config/env.schema.ts.
NODE_ENV=development
PORT=4005
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=300
# notifications has its own database and DB user (ADR-0001: database per service).
DATABASE_URL=postgresql://notifications:notifications@localhost:5432/notifications
REDIS_URL=redis://localhost:6379
IDENTITY_URL=http://localhost:4001
ROLE_CACHE_SECONDS=60
