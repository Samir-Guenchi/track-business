# Copy to .env (never commit .env). All values are validated at startup in src/config/env.schema.ts.
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
RATE_LIMIT_PER_MINUTE=300
# Internal URLs of the services the gateway forwards to (routes in src/routing/route-table.ts).
IDENTITY_URL=http://localhost:4001
SHIPPING_URL=http://localhost:4002
ORDERS_URL=http://localhost:4003
PAYMENTS_URL=http://localhost:4004
NOTIFICATIONS_URL=http://localhost:4005
INTEGRATIONS_URL=http://localhost:4006
