{
  "name": "@trackecom/gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nest build -p tsconfig.build.json",
    "dev": "nest start --watch -p tsconfig.build.json --exec \"node --env-file-if-exists=.env\"",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/http-proxy": "^11.6.6",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-fastify": "^12.3.2",
    "@trackecom/contracts": "workspace:*",
    "@trackecom/service-kit": "workspace:*",
    "fastify": "^5.12.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.11",
    "@nestjs/testing": "^12.3.2",
    "@swc/core": "^1.16.22",
    "@trackecom/config": "workspace:*",
    "@types/node": "^24.0.0",
    "eslint": "^10.14.0",
    "typescript": "~6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
