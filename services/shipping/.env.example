# Copy to .env (never commit .env). Validated at startup by src/config/env.schema.ts.
NODE_ENV=development
PORT=4002
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=300
# shipping has its own database and DB user (ADR-0001: database per service).
DATABASE_URL=postgresql://shipping:shipping@localhost:5432/shipping
REDIS_URL=redis://localhost:6379
