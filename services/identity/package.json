{
  "name": "@trackecom/identity",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "prisma",
    "prisma.config.ts"
  ],
  "scripts": {
    "generate": "prisma generate",
    "build": "nest build -p tsconfig.build.json",
    "dev": "nest start --watch -p tsconfig.build.json --exec \"node --env-file-if-exists=.env\"",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@nestjs/common": "^12.4.0",
    "@nestjs/core": "^12.4.0",
    "@nestjs/platform-fastify": "^12.4.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@trackecom/audit": "workspace:*",
    "@trackecom/contracts": "workspace:*",
    "@trackecom/events": "workspace:*",
    "@trackecom/service-kit": "workspace:*",
    "argon2": "^0.45.2",
    "fastify": "^5.12.8",
    "ioredis": "^6.0.0",
    "jose": "^6.2.14",
    "nodemailer": "^10.3.1",
    "prisma": "^7.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.12",
    "@nestjs/testing": "^12.4.0",
    "@swc/core": "^1.16.22",
    "@trackecom/config": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "eslint": "^10.14.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript7": "npm:typescript@~7.0.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
