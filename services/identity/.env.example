# Copy to .env (never commit .env). Validated at startup by src/config/env.schema.ts.
NODE_ENV=development
PORT=4001
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=300
# identity has its own database and DB user (ADR-0001: database per service).
DATABASE_URL=postgresql://identity:identity@localhost:5432/identity
REDIS_URL=redis://localhost:6379
# Access tokens: ES256 private key, PKCS#8 PEM with newlines as \n. Leave empty in dev (a throwaway key is generated).
# Generate: openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256
JWT_PRIVATE_KEY=
JWT_KEY_ID=identity-1
APP_URL=http://localhost:3000
# Mailpit locally (docker compose); real SMTP in staging/production.
SMTP_URL=smtp://localhost:1025
MAIL_FROM=TrackEcom <no-reply@trackecom.local>
