// Authentication (#15). Passwords: argon2id. Tokens are stored as SHA-256 hashes only.

enum Locale {
  ar
  fr
  en
}

model User {
  id                String         @id @db.Uuid
  email             String         @unique
  passwordHash      String         @map("password_hash")
  name              String
  phone             String?
  locale            Locale         @default(ar)
  emailVerifiedAt   DateTime?      @map("email_verified_at") @db.Timestamptz(3)
  failedLoginCount  Int            @default(0) @map("failed_login_count")
  lockedUntil       DateTime?      @map("locked_until") @db.Timestamptz(3)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  refreshTokens     RefreshToken[]
  oneTimeTokens     UserToken[]

  @@map("users")
}

/// Rotating refresh tokens. Reusing a rotated token revokes the whole family (stolen token).
model RefreshToken {
  id          String    @id @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  familyId    String    @map("family_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  rotatedAt   DateTime? @map("rotated_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@map("refresh_tokens")
}

enum UserTokenPurpose {
  email_verification
  password_reset
}

/// Single-use links sent by email.
model UserToken {
  id         String           @id @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  purpose    UserTokenPurpose
  tokenHash  String           @unique @map("token_hash")
  expiresAt  DateTime         @map("expires_at") @db.Timestamptz(3)
  usedAt     DateTime?        @map("used_at") @db.Timestamptz(3)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("user_tokens")
}
