# Copy to .env (never commit .env). Validated at startup by src/config/env.schema.ts.
NODE_ENV=development
PORT=4003
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=300
# orders has its own database and DB user (ADR-0001: database per service).
DATABASE_URL=postgresql://orders:orders@localhost:5432/orders
REDIS_URL=redis://localhost:6379
IDENTITY_URL=http://localhost:4001
SHIPPING_URL=http://localhost:4002
# Shared refused-parcel signal across stores (#52); keep false until the privacy call is made.
NETWORK_SIGNAL_ENABLED=false
ROLE_CACHE_SECONDS=60
