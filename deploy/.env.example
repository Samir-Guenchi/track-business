# Written to the host by the deploy workflow from GitHub environment secrets. Never commit real values.
IMAGE_TAG=sha-0000000
DEPLOY_ENV=staging
API_DOMAIN=api.staging.example.dz
CORS_ORIGINS=https://staging.example.dz
SENTRY_DSN=
IDENTITY_DATABASE_URL=postgresql://identity:CHANGE_ME@db-host:5432/identity?sslmode=require
SHIPPING_DATABASE_URL=postgresql://shipping:CHANGE_ME@db-host:5432/shipping?sslmode=require
# 32 random bytes, base64 (openssl rand -base64 32). Losing it makes stored carrier credentials unreadable.
CARRIER_KEK=CHANGE_ME
CARRIER_KEK_ID=v1
# orders needs the pg_trgm extension (search); most managed Postgres allow it.
ORDERS_DATABASE_URL=postgresql://orders:CHANGE_ME@db-host:5432/orders?sslmode=require
# payments: COD reconciliation and ledger (ADR-0002).
PAYMENTS_DATABASE_URL=postgresql://payments:CHANGE_ME@db-host:5432/payments?sslmode=require
JWT_PRIVATE_KEY=
APP_URL=https://staging.example.dz
SMTP_URL=smtps://user:CHANGE_ME@smtp.example.com:465
MAIL_FROM=TrackEcom <no-reply@example.dz>
