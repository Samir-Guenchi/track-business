    "@trackecom/config": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.14.0",
    "jsdom": "^26.1.0",
    "storybook": "^10.6.5",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3",
